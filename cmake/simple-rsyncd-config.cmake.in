# simple-rsyncd CMake Configuration File
# This file is generated by CMake and should not be edited manually

@PACKAGE_INIT@

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/simple-rsyncd-targets.cmake")

# Set package properties
set(simple-rsyncd_VERSION "@PROJECT_VERSION@")
set(simple-rsyncd_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(simple-rsyncd_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(simple-rsyncd_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

# Set package description
set(simple-rsyncd_DESCRIPTION "Simple RSync Daemon - A lightweight and secure rsync server")

# Set package homepage
set(simple-rsyncd_HOMEPAGE "https://github.com/simple-rsyncd/simple-rsyncd")

# Set package maintainer
set(simple-rsyncd_MAINTAINER "support@blburns.com")

# Set package license
set(simple-rsyncd_LICENSE "Apache-2.0")

# Set package category
set(simple-rsyncd_CATEGORY "net")

# Set package keywords
set(simple-rsyncd_KEYWORDS "rsync;daemon;server;file-transfer;sync;backup")

# Set package dependencies
set(simple-rsyncd_DEPENDENCIES "OpenSSL;jsoncpp")

# Set package features
set(simple-rsyncd_FEATURES "SSL;JSON_CONFIG;LOGGING;MULTI_INSTANCE")

# Set package components
set(simple-rsyncd_COMPONENTS "runtime;library;headers;config;deployment;docs")

# Set package installation paths
if(APPLE)
    set(simple-rsyncd_INSTALL_PREFIX "/usr/local")
    set(simple-rsyncd_BIN_DIR "${simple-rsyncd_INSTALL_PREFIX}/bin")
    set(simple-rsyncd_LIB_DIR "${simple-rsyncd_INSTALL_PREFIX}/lib")
    set(simple-rsyncd_INCLUDE_DIR "${simple-rsyncd_INSTALL_PREFIX}/include")
    set(simple-rsyncd_CONFIG_DIR "${simple-rsyncd_INSTALL_PREFIX}/etc/simple-rsyncd")
    set(simple-rsyncd_DEPLOYMENT_DIR "${simple-rsyncd_INSTALL_PREFIX}/share/simple-rsyncd")
    set(simple-rsyncd_DOCS_DIR "${simple-rsyncd_INSTALL_PREFIX}/share/simple-rsyncd/docs")
    set(simple-rsyncd_LOG_DIR "${simple-rsyncd_INSTALL_PREFIX}/var/log/simple-rsyncd")
    set(simple-rsyncd_RUN_DIR "${simple-rsyncd_INSTALL_PREFIX}/var/run/simple-rsyncd")
elseif(WIN32)
    set(simple-rsyncd_INSTALL_PREFIX "C:/Program Files/simple-rsyncd")
    set(simple-rsyncd_BIN_DIR "${simple-rsyncd_INSTALL_PREFIX}/bin")
    set(simple-rsyncd_LIB_DIR "${simple-rsyncd_INSTALL_PREFIX}/lib")
    set(simple-rsyncd_INCLUDE_DIR "${simple-rsyncd_INSTALL_PREFIX}/include")
    set(simple-rsyncd_CONFIG_DIR "${simple-rsyncd_INSTALL_PREFIX}/config")
    set(simple-rsyncd_DEPLOYMENT_DIR "${simple-rsyncd_INSTALL_PREFIX}/deployment")
    set(simple-rsyncd_DOCS_DIR "${simple-rsyncd_INSTALL_PREFIX}/docs")
    set(simple-rsyncd_LOG_DIR "${simple-rsyncd_INSTALL_PREFIX}/logs")
    set(simple-rsyncd_RUN_DIR "${simple-rsyncd_INSTALL_PREFIX}/temp")
else()
    set(simple-rsyncd_INSTALL_PREFIX "/usr/local")
    set(simple-rsyncd_BIN_DIR "/usr/bin")
    set(simple-rsyncd_LIB_DIR "/usr/lib")
    set(simple-rsyncd_INCLUDE_DIR "/usr/include")
    set(simple-rsyncd_CONFIG_DIR "/etc/simple-rsyncd")
    set(simple-rsyncd_DEPLOYMENT_DIR "/usr/share/simple-rsyncd")
    set(simple-rsyncd_DOCS_DIR "/usr/share/simple-rsyncd/docs")
    set(simple-rsyncd_LOG_DIR "/var/log/simple-rsyncd")
    set(simple-rsyncd_RUN_DIR "/var/run/simple-rsyncd")
endif()

# Set package variables for use in other CMake files
set(simple-rsyncd_FOUND TRUE)
set(simple-rsyncd_INCLUDE_DIRS "${simple-rsyncd_INCLUDE_DIR}")
